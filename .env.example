QST_DB_PATH=data/qingshitong.db
QST_APP_ENV=development
QST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Provider 只由服务端部署配置决定，学生端页面不会提交或覆盖这些字段。
QST_LLM_PROVIDER=openrouter
QST_LLM_BASE_URL=https://openrouter.ai/api/v1
QST_LLM_API_KEY_FILE=
# 本地兼容回退；生产环境优先使用 Secret 文件，不要把真实值提交到 Git。
QST_LLM_API_KEY=
QST_LLM_MODEL=nex-agi/nex-n2.5-mini:free
QST_LLM_TIMEOUT_SECONDS=20
QST_LLM_RUN_TIMEOUT_SECONDS=45
QST_LLM_MAX_TURNS=2
QST_LLM_MAX_OUTPUT_TOKENS=320
QST_LLM_RETRY_COUNT=1
# Responses 请求方言：standard 适用于标准 OpenAI-compatible；中转站若要求将指令并入 input 且使用 max_tokens，填 message_input_max_tokens。
QST_LLM_RESPONSES_REQUEST_VARIANT=standard
# Chat Completions 推理预算方言：只在 Provider 支持时设置；SenseNova GLM 可设为 none，避免 reasoning 摘要耗尽回答预算。
QST_LLM_CHAT_REASONING_EFFORT=
# R0 本地 Embedding 只允许这两个 Profile；默认使用 BGE-base，切换前必须准备对应本地模型和完整索引。
QST_EMBEDDING_PROFILE=bge-base-zh-v1.5
QST_EMBEDDING_CACHE_DIR=models/embeddings
